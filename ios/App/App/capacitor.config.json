{
	"appId": "com.shady.halalaqirsh",
	"appName": "هللة وقرش",
	"webDir": "dist",
	"plugins": {
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"StatusBar": {
			"overlaysWebView": true
		}
	},
	"ios": {
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"backgroundColor": "#000000"
	},
	"packageClassList": [
		"BiometricAuthNative",
		"AppPlugin",
		"ClipboardPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"LocalNotificationsPlugin",
		"PreferencesPlugin",
		"SharePlugin",
		"StatusBarPlugin",
		"SecureStoragePlugin"
	]
}
